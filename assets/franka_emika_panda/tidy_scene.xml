<mujoco model="lang tidy scene">
  <!-- Franka Panda (MuJoCo Menagerie, Apache-2.0) + 卓上片付けシーン -->
  <include file="panda_tidy.xml"/>

  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <visual>
    <headlight diffuse="0.35 0.35 0.35" ambient="0.25 0.25 0.25" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-25" offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.5 0.65" rgb2="0.05 0.08 0.12" width="512" height="3072"/>
    <texture type="2d" name="floor_tex" builtin="checker" mark="edge" rgb1="0.25 0.27 0.3" rgb2="0.2 0.22 0.25"
      markrgb="0.5 0.5 0.5" width="300" height="300"/>
    <material name="floor_mat" texture="floor_tex" texuniform="true" texrepeat="4 4" reflectance="0.1"/>
    <texture type="2d" name="wood" builtin="flat" rgb1="0.82 0.74 0.62" width="64" height="64"/>
    <material name="table_mat" texture="wood" rgba="0.85 0.78 0.66 1" reflectance="0.05"/>
  </asset>

  <default>
    <default class="block">
      <geom condim="4" friction="1.2 0.02 0.002" solref="0.005 1" density="600"/>
    </default>
    <default class="plate">
      <geom type="cylinder" size="0.075 0.004" contype="1" conaffinity="1" friction="1 0.02 0.002"/>
    </default>
  </default>

  <worldbody>
    <light pos="0.4 -0.6 1.8" dir="-0.1 0.4 -1" directional="true" castshadow="true" diffuse="0.5 0.5 0.5"/>
    <light pos="0.6 0.6 1.5" dir="0 -0.3 -1" directional="true" castshadow="false" diffuse="0.25 0.25 0.25"/>

    <geom name="floor" pos="0 0 -0.75" size="0 0 0.05" type="plane" material="floor_mat"/>
    <!-- テーブル (天板上面 z=0) -->
    <geom name="table" type="box" pos="0.4 0 -0.375" size="0.55 0.65 0.375" material="table_mat"/>

    <!-- 真上から見下ろす認識用カメラ (画像上方向 = world +x) -->
    <camera name="top_cam" pos="0.52 0 1.05" xyaxes="0 -1 0 1 0 0" fovy="50"/>

    <!-- お皿 (固定) -->
    <body name="plate_blue" pos="0.40 -0.32 0.004">
      <geom name="plate_blue" class="plate" rgba="0.15 0.35 0.95 1"/>
    </body>
    <body name="plate_pink" pos="0.40 0.32 0.004">
      <geom name="plate_pink" class="plate" rgba="0.95 0.3 0.65 1"/>
    </body>

    <!-- 動かせる物体 -->
    <body name="red_cube" pos="0.55 0.10 0.02">
      <freejoint name="red_cube"/>
      <geom name="red_cube" class="block" type="box" size="0.02 0.02 0.02" rgba="0.9 0.12 0.1 1"/>
    </body>
    <body name="yellow_cube" pos="0.62 -0.08 0.02">
      <freejoint name="yellow_cube"/>
      <geom name="yellow_cube" class="block" type="box" size="0.02 0.02 0.02" rgba="0.98 0.85 0.1 1"/>
    </body>
    <body name="blue_cube" pos="0.48 -0.05 0.02">
      <freejoint name="blue_cube"/>
      <geom name="blue_cube" class="block" type="box" size="0.02 0.02 0.02" rgba="0.1 0.3 0.95 1"/>
    </body>
    <body name="green_cylinder" pos="0.66 0.16 0.025">
      <freejoint name="green_cylinder"/>
      <geom name="green_cylinder" class="block" type="cylinder" size="0.02 0.025" rgba="0.15 0.75 0.25 1"/>
    </body>
  </worldbody>
</mujoco>
